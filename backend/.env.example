# DuoSync / RiftAffinity - Variables d'environnement Backend

# Obtenez votre clé API développeur gratuite sur : https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-xxxx-xxxx-xxxx-xxxx

# Configuration du cache (en secondes, par défaut 2 heures)
CACHE_TTL=7200

# Limite d'analyse de l'historique par joueur
MAX_MATCHES_TO_FETCH=300

# Optionnel : Connexion Upstash Redis
REDIS_URL=

# Configuration E-mail SMTP (Gmail, Brevo, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_d_application
SENDER_EMAIL=votre.email@gmail.com

